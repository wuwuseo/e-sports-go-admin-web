# Auto detect text files and perform LF normalization
* text=auto

# Source code - force LF
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.less text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.env text eol=lf
*.env.* text eol=lf
.eslintrc.js text eol=lf
.prettierrc.js text eol=lf
.stylelintrc.js text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Config files
*.config.js text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
